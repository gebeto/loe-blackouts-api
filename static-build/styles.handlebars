<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Serif:wght@300;400&display=swap" rel="stylesheet">
<style>
  :root {
    --page: #dddbd7;
    --grid: rgba(0, 0, 0, 0.04);
    --block: #f8f7f5;
    --block-hover: #fbf6ea;
    --bar: #ecebe7;
    --border: #b9b5ae;
    --text: #1d1c1a;
    --muted: #6d6a64;
    --accent: #f2a900;
    --accent-ink: #8f5b00;
    --panel: #16140f;
    --panel-border: #16140f;
    --panel-text: #d9d5cc;
    --panel-muted: #7a756b;
    --syn-amber: #e0a84a;
    --syn-teal: #7fb5a8;
    --syn-purple: #b39ddb;
    --syn-green: #a6c48a;
    --syn-red: #e08a7e;
    --serif: "IBM Plex Serif", Georgia, serif;
    --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --page: #161513;
      --grid: rgba(255, 255, 255, 0.03);
      --block: #1e1d1b;
      --block-hover: #26221a;
      --bar: #252421;
      --border: #3b3935;
      --text: #e9e7e2;
      --muted: #9a968e;
      --accent-ink: #f2b740;
      --panel: #0d0c0a;
      --panel-border: #3b3935;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background-color: var(--page);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent-ink);
  }

  .page {
    max-width: 560px;
    margin: 0 auto;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cell {
    background: var(--block);
    border: 1px solid var(--border);
    border-radius: 2px;
  }

  .header {
    padding: 24px;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
  }

  h1 {
    margin: 16px 0 8px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .accent {
    color: var(--accent-ink);
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .section {
    overflow: hidden;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    padding: 8px 16px;
    background: var(--bar);
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    outline: 1px solid transparent;
    outline-offset: -1px;
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row-label {
    flex: 1;
    font-family: var(--serif);
    font-size: 20px;
  }

  .row-path,
  .row-arrow {
    color: var(--muted);
  }

  .slot {
    gap: 16px;
  }

  .slot-title {
    min-width: 48px;
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.2;
  }

  .schedule {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .day {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
  }

  .day-label {
    min-width: 64px;
    font-size: 12px;
    color: var(--muted);
  }

  .range {
    padding: 0 6px;
    font-size: 12px;
    background: var(--bar);
    border: 1px solid var(--border);
    border-radius: 2px;
  }

  .on {
    font-size: 12px;
    color: var(--muted);
  }

  .slot-label {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  .row:hover,
  .row:focus-visible {
    background: var(--block-hover);
    outline-color: var(--accent);
  }

  .row:hover .row-arrow,
  .row:focus-visible .row-arrow,
  .row:hover .slot-label,
  .row:focus-visible .slot-label {
    color: var(--accent-ink);
  }

  .kbd {
    display: inline-block;
    min-width: 22px;
    padding: 1px 6px;
    font-family: var(--mono);
    font-size: 12px;
    text-align: center;
    color: var(--muted);
    background: var(--bar);
    border: 1px solid var(--border);
    border-radius: 2px;
    box-shadow: inset 0 -1px 0 var(--border);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    color: var(--muted);
    text-decoration: none;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--accent-ink);
  }

  .panel {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 2px;
    color: var(--panel-text);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.7;
  }

  .c { color: var(--panel-muted); }
  .k { color: var(--syn-purple); }
  .s { color: var(--syn-green); }
  .n { color: var(--syn-amber); }
  .t { color: var(--syn-teal); }
  .r { color: var(--syn-red); }

  footer {
    font-size: 12px;
    color: var(--muted);
  }

  footer a {
    color: inherit;
  }

  @media (max-width: 480px) {
    .page {
      padding-top: 24px;
    }

    h1 {
      font-size: 28px;
    }

    .slot-label {
      display: none;
    }
  }
</style>
